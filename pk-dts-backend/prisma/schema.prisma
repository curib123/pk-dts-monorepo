model DocumentWorkflowStep {
  workflow_step_id                 BigInt                              @id @default(autoincrement())
  document_id                      BigInt
  document                         Document                            @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  stage                            DocumentWorkflowStage
  node_key                         String?                             @db.VarChar(100)
  sequence                         Int
  assigned_user_id                 BigInt?
  assignee                         User?                               @relation("WorkflowStepAssignees", fields: [assigned_user_id], references: [user_id], onDelete: SetNull)
  stage_label                      String?                             @db.VarChar(150)
  assignment_source                String?                             @db.VarChar(50)
  assignment_type                  String?                             @db.VarChar(30)
  assigned_role_id                 BigInt?
  assigned_role                    Role?                               @relation("WorkflowStepAssignedRoles", fields: [assigned_role_id], references: [role_id], onDelete: SetNull)
  required_permission              String?                             @db.VarChar(120)
  condition_json                   Json?
  on_approve_node_key              String?                             @db.VarChar(100)
  on_reject_node_key               String?                             @db.VarChar(100)
  on_return_node_key               String?                             @db.VarChar(100)
  assigned_user_name_snapshot      String?                             @db.VarChar(255)
  assigned_position_title_snapshot String?                             @db.VarChar(150)
  assigned_at                      DateTime                            @default(now())
  status                           WorkflowStepStatus                  @default(PENDING)
  acted_by_user_id                 BigInt?
  actor                            User?                               @relation("WorkflowStepActors", fields: [acted_by_user_id], references: [user_id], onDelete: SetNull)
  decision                         String?                             @db.VarChar(30)
  comments                         String?                             @db.Text
  acted_at                         DateTime?
  acted_user_name_snapshot         String?                             @db.VarChar(255)
  acted_position_title_snapshot    String?                             @db.VarChar(150)
  assignment_history               DocumentWorkflowAssignmentHistory[]
  created_at                       DateTime                            @default(now())

  @@unique([document_id, node_key])
  @@index([assigned_user_id, status])
  @@index([assigned_role_id, status])
  @@map("document_workflow_steps")
}

model DocumentWorkflowAssignmentHistory {
  assignment_history_id BigInt               @id @default(autoincrement())
  workflow_step_id      BigInt
  workflow_step         DocumentWorkflowStep @relation(fields: [workflow_step_id], references: [workflow_step_id], onDelete: Cascade)
  previous_user_id      BigInt?
  new_user_id           BigInt
  changed_by_user_id    BigInt
  previous_user_name    String?              @db.VarChar(255)
  new_user_name         String               @db.VarChar(255)
  new_position_title    String?              @db.VarChar(150)
  reason                String               @db.Text
  changed_at            DateTime             @default(now())

  @@index([workflow_step_id, changed_at])
  @@map("document_workflow_assignment_history")
}

model DocumentApproverConfiguration {
  approver_configuration_id   BigInt   @id @default(autoincrement())
  document_id                 BigInt   @unique
  document                    Document @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  noted_by_user_id            BigInt?
  plant_manager_user_id       BigInt?
  document_controller_user_id BigInt?
  hardcopy_approver_user_id   BigInt?
  access_approver_user_id     BigInt?
  document_owner_user_id      BigInt?
  workflow_name               String?  @db.VarChar(150)
  workflow_version            Int      @default(1)
  workflow_plan               Json?
  configured_by_user_id       BigInt
  configured_by               User     @relation("ConfiguredApprovers", fields: [configured_by_user_id], references: [user_id], onDelete: Restrict)
  document_owner              User?    @relation("DocumentApproverOwners", fields: [document_owner_user_id], references: [user_id], onDelete: SetNull)
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  @@map("document_approver_configurations")
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model WorkflowDefinition {
  workflow_definition_id BigInt            @id @default(autoincrement())
  workflow_key           String            @unique @db.VarChar(100)
  name                   String            @db.VarChar(150)
  description            String?           @db.Text
  document_type          DocumentType?
  is_active              Boolean           @default(true)
  created_by_user_id     BigInt
  created_by             User              @relation("WorkflowDefinitionCreators", fields: [created_by_user_id], references: [user_id], onDelete: Restrict)
  versions               WorkflowVersion[]
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt

  @@index([document_type, is_active])
  @@map("workflow_definitions")
}

model WorkflowVersion {
  workflow_version_id        BigInt                    @id @default(autoincrement())
  workflow_definition_id     BigInt
  workflow_definition        WorkflowDefinition        @relation(fields: [workflow_definition_id], references: [workflow_definition_id], onDelete: Restrict)
  version_number             Int
  status                     WorkflowVersionStatus     @default(DRAFT)
  graph                      Json
  created_by_user_id         BigInt
  created_by                 User                      @relation("WorkflowVersionCreators", fields: [created_by_user_id], references: [user_id], onDelete: Restrict)
  published_by_user_id       BigInt?
  published_by               User?                     @relation("WorkflowVersionPublishers", fields: [published_by_user_id], references: [user_id], onDelete: SetNull)
  published_at               DateTime?
  documents                  Document[]
  hardcopy_transfer_requests HardcopyTransferRequest[] @relation("HardcopyTransferWorkflowVersions")
  created_at                 DateTime                  @default(now())
  updated_at                 DateTime                  @updatedAt

  @@unique([workflow_definition_id, version_number])
  @@index([status, published_at])
  @@map("workflow_versions")
}

