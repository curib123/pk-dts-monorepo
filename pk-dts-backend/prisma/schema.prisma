generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  user_id                 BigInt  @id @default(autoincrement())
  firstname               String  @db.VarChar(100)
  lastname                String  @db.VarChar(100)
  middlename              String? @db.VarChar(100)
  username                String  @unique @db.VarChar(150)
  position_title          String? @db.VarChar(100)
  password                String  @db.VarChar(255)
  require_password_change Boolean @default(false)

  role_id BigInt
  role    Role   @relation(fields: [role_id], references: [role_id])

  leader_id   BigInt?
  leader      User?   @relation("UserLeaders", fields: [leader_id], references: [user_id], onDelete: SetNull)
  noted_users User[]  @relation("UserLeaders")

  created_documents                 Document[]                            @relation("CreatedDocuments")
  requested_documents               Document[]                            @relation("RequestedDocuments")
  disposed_documents                Document[]                            @relation("DisposedDocuments")
  disposal_requests                 DocumentDisposalRequest[]             @relation("DisposalRequesters")
  disposal_request_reviews          DocumentDisposalRequest[]             @relation("DisposalRequestReviewers")
  reviewed_documents                Document[]                            @relation("ReviewedDocuments")
  document_status_history           DocumentStatusHistory[]               @relation("DocumentStatusActors")
  uploaded_revisions                DocumentRevision[]                    @relation("UploadedRevisions")
  approved_revisions                DocumentRevision[]                    @relation("ApprovedRevisions")
  uploaded_softcopy_attachments     SoftcopyAttachment[]                  @relation("UploadedSoftcopyAttachments")
  approved_softcopy_attachments     SoftcopyAttachment[]                  @relation("ApprovedSoftcopyAttachments")
  rejected_softcopy_attachments     SoftcopyAttachment[]                  @relation("RejectedSoftcopyAttachments")
  uploaded_hardcopy_attachments     HardcopyAttachment[]                  @relation("UploadedHardcopyAttachments")
  document_assignments              DocumentAssignment[]                  @relation("AssignedDocuments")
  assigned_documents                DocumentAssignment[]                  @relation("DocumentAssignmentActors")
  document_access_requests          DocumentAccessRequest[]               @relation("DocumentAccessRequesters")
  access_request_histories          DocumentAccessRequestHistory[]        @relation("AccessRequestHistoryActors")
  reviewed_document_access_requests DocumentAccessRequest[]               @relation("DocumentAccessReviewers")
  access_request_approvals          DocumentAccessRequest[]               @relation("DocumentAccessRequestApprovers")
  created_softcopy_categories       SoftcopyCategory[]                    @relation("CreatedSoftcopyCategories")
  reviewed_registration_requests    AccountRegistrationRequest[]          @relation("RegistrationReviewer")
  notification_reads                NotificationRead[]
  audit_logs                        AuditLog[]
  approval_assignments              DocumentWorkflowStep[]                @relation("WorkflowStepAssignees")
  approval_actions                  DocumentWorkflowStep[]                @relation("WorkflowStepActors")
  approver_configurations           DocumentApproverConfiguration[]       @relation("ConfiguredApprovers")
  configured_document_approvers     DocumentApproverConfiguration[]       @relation("DocumentApproverOwners")
  transfer_requests_requested       HardcopyTransferRequest[]             @relation("TransferRequesters")
  transfer_requests_approved        HardcopyTransferRequest[]             @relation("TransferApprovers")
  transfer_requests_recipients      HardcopyTransferRequest[]             @relation("TransferRecipients")
  transfer_acceptances              HardcopyTransferRequest[]             @relation("TransferAcceptors")
  transfer_history                  HardcopyTransferHistory[]             @relation("TransferHistoryActors")
  transfer_workflow_steps_assigned  HardcopyTransferWorkflowStep[]        @relation("TransferWorkflowStepAssignees")
  transfer_workflow_steps_acted     HardcopyTransferWorkflowStep[]        @relation("TransferWorkflowStepActors")
  transfer_workflow_histories       HardcopyTransferWorkflowStepHistory[] @relation("TransferWorkflowHistoryActors")
  workflow_definitions_created      WorkflowDefinition[]                  @relation("WorkflowDefinitionCreators")
  workflow_versions_created         WorkflowVersion[]                     @relation("WorkflowVersionCreators")
  workflow_versions_published       WorkflowVersion[]                     @relation("WorkflowVersionPublishers")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model AuditLog {
  audit_log_id     BigInt   @id @default(autoincrement())
  user_id          BigInt?
  user             User?    @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  user_name        String   @db.VarChar(220)
  user_username    String   @db.VarChar(150)
  role_name        String   @db.VarChar(100)
  action           String   @db.VarChar(30)
  module           String   @db.VarChar(100)
  description      String   @db.VarChar(500)
  method           String   @db.VarChar(10)
  path             String   @db.VarChar(500)
  entity_id        String?  @db.VarChar(100)
  metadata         Json?
  before_state     Json?
  after_state      Json?
  reason           String?  @db.Text
  workflow_context Json?
  ip_address       String?  @db.VarChar(100)
  user_agent       String?  @db.VarChar(500)
  created_at       DateTime @default(now())

  @@index([user_id, created_at])
  @@index([module, created_at])
  @@index([entity_id, created_at])
  @@map("audit_logs")
}

model NotificationRead {
  notification_read_id BigInt   @id @default(autoincrement())
  user_id              BigInt
  user                 User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  event_key            String   @db.VarChar(180)
  read_at              DateTime @default(now())

  @@unique([user_id, event_key])
  @@index([user_id, read_at])
  @@map("notification_reads")
}

model Role {
  role_id     BigInt  @id @default(autoincrement())
  role_name   String  @unique @db.VarChar(100)
  description String? @db.Text

  users                              User[]
  role_permissions                   RolePermission[]
  workflow_step_assignments          DocumentWorkflowStep[]         @relation("WorkflowStepAssignedRoles")
  transfer_workflow_step_assignments HardcopyTransferWorkflowStep[] @relation("TransferWorkflowStepAssignedRoles")
  requested_registration_requests    AccountRegistrationRequest[]   @relation("RequestedRegistrationRole")
  assigned_registration_requests     AccountRegistrationRequest[]   @relation("AssignedRegistrationRole")

  @@map("roles")
}

model AccountRegistrationRequest {
  registration_id   BigInt             @id @default(autoincrement())
  reference_code    String             @unique @db.VarChar(40)
  firstname         String             @db.VarChar(100)
  lastname          String             @db.VarChar(100)
  middlename        String?            @db.VarChar(100)
  username          String             @db.VarChar(150)
  position_title    String?            @db.VarChar(100)
  applicant_remarks String?            @db.Text
  password_hash     String             @db.VarChar(255)
  status            RegistrationStatus @default(PENDING)
  review_remarks    String?            @db.Text

  requested_role_id   BigInt
  requested_role      Role    @relation("RequestedRegistrationRole", fields: [requested_role_id], references: [role_id])
  assigned_role_id    BigInt?
  assigned_role       Role?   @relation("AssignedRegistrationRole", fields: [assigned_role_id], references: [role_id])
  reviewed_by_user_id BigInt?
  reviewed_by         User?   @relation("RegistrationReviewer", fields: [reviewed_by_user_id], references: [user_id])

  reviewed_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([username, status])
  @@index([status, created_at])
  @@map("account_registration_requests")
}

model Permission {
  permission_id   BigInt  @id @default(autoincrement())
  permission_name String  @unique @db.VarChar(120)
  module_key      String  @db.VarChar(100)
  module_label    String  @db.VarChar(150)
  action_key      String  @db.VarChar(100)
  action_label    String  @db.VarChar(150)
  description     String? @db.Text

  role_permissions RolePermission[]

  @@unique([module_key, action_key])
  @@map("permissions")
}

model RolePermission {
  role_permission_id BigInt @id @default(autoincrement())

  role_id BigInt
  role    Role   @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  permission_id BigInt
  permission    Permission @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model Area {
  area_id   BigInt @id @default(autoincrement())
  area_name String @db.VarChar(150)

  specifics                  Specific[]
  hardcopies                 HardcopyDocument[]
  transfer_from_areas        HardcopyTransferRequest[] @relation("HardcopyTransferFromArea")
  transfer_destination_areas HardcopyTransferRequest[] @relation("HardcopyTransferDestinationArea")

  @@map("areas")
}

model Specific {
  specific_id   BigInt @id @default(autoincrement())
  specific_name String @db.VarChar(150)

  area_id BigInt?
  area    Area?   @relation(fields: [area_id], references: [area_id], onDelete: SetNull)

  hardcopies                     HardcopyDocument[]
  assets                         AssetNumber[]
  locations                      Location[]
  transfer_from_specifics        HardcopyTransferRequest[] @relation("HardcopyTransferFromSpecific")
  transfer_destination_specifics HardcopyTransferRequest[] @relation("HardcopyTransferDestinationSpecific")

  @@map("specifics")
}

model Location {
  location_id   BigInt    @id @default(autoincrement())
  location_name String    @unique @db.VarChar(150)
  location_code String?   @unique @db.VarChar(20)
  is_active     Boolean   @default(true)
  archived_at   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  asset_id BigInt?
  asset    AssetNumber? @relation(fields: [asset_id], references: [asset_id], onDelete: SetNull)

  specific_id BigInt?
  specific    Specific? @relation(fields: [specific_id], references: [specific_id], onDelete: SetNull)

  hardcopies                     HardcopyDocument[]
  transfer_from_locations        HardcopyTransferRequest[] @relation("HardcopyTransferFromLocation")
  transfer_destination_locations HardcopyTransferRequest[] @relation("HardcopyTransferDestinationLocation")

  @@index([asset_id])
  @@index([specific_id])
  @@map("locations")
}

model SystemSequenceState {
  sequence_key String @id @db.VarChar(100)
  next_value   BigInt @default(0)

  @@map("system_sequence_states")
}

model Sequence {
  sequence_id   BigInt @id @default(autoincrement())
  sequence_code String @unique @db.VarChar(50)

  hardcopies                     HardcopyDocument[]
  transfer_from_sequences        HardcopyTransferRequest[] @relation("HardcopyTransferFromSequence")
  transfer_destination_sequences HardcopyTransferRequest[] @relation("HardcopyTransferDestinationSequence")

  @@map("sequences")
}

model AssetNumber {
  asset_id     BigInt   @id @default(autoincrement())
  asset_number String   @unique @db.VarChar(100)
  created_at   DateTime @default(now())

  specific_id BigInt?
  specific    Specific?  @relation(fields: [specific_id], references: [specific_id], onDelete: SetNull)
  locations   Location[]

  hardcopies                  HardcopyDocument[]        @relation("AssetHardcopy")
  transfer_from_assets        HardcopyTransferRequest[] @relation("HardcopyTransferFromAsset")
  transfer_destination_assets HardcopyTransferRequest[] @relation("HardcopyTransferDestinationAsset")

  @@index([specific_id])
  @@map("asset_numbers")
}

model Document {
  document_id             BigInt                  @id @default(autoincrement())
  document_title          String                  @db.VarChar(255)
  document_type           DocumentType
  status                  DocumentStatus          @default(Draft)
  request_date            DateTime                @default(now())
  department              String?                 @db.VarChar(150)
  business_document_type  DocumentBusinessType?
  action_requested        DocumentActionRequested @default(CREATE_REVISE)
  from_party              String?                 @db.VarChar(150)
  to_party                String?                 @db.VarChar(150)
  reason_for_change       DocumentChangeReason?
  brief_description       String?                 @db.Text
  proposed_change         String?                 @db.Text
  revision_level_from     String?                 @db.VarChar(50)
  revision_level_to       String?                 @db.VarChar(50)
  previous_effective_date DateTime?
  new_effective_date      DateTime?
  date_received           DateTime?
  date_released           DateTime?
  approval_date           DateTime?
  legacy_imported         Boolean                 @default(false)
  legacy_import_note      String?                 @db.Text
  creation_source         String                  @default("DCR") @db.VarChar(30)
  creation_reason         String?                 @db.Text
  direct_created_at       DateTime?
  status_before_disposal  DocumentStatus?
  requested_by_name       String?                 @db.VarChar(150)
  disposal_remarks        String?                 @db.Text
  disposal_action         DisposalAction?
  disposal_action_other   String?                 @db.VarChar(150)
  disposed_at             DateTime?
  disposed_by_name        String?                 @db.VarChar(150)

  created_by BigInt
  creator    User   @relation("CreatedDocuments", fields: [created_by], references: [user_id])

  requested_by_user_id BigInt?
  requester            User?   @relation("RequestedDocuments", fields: [requested_by_user_id], references: [user_id])

  disposed_by_user_id       BigInt?
  disposer                  User?                          @relation("DisposedDocuments", fields: [disposed_by_user_id], references: [user_id])
  reviewed_by_user_id       BigInt?
  reviewer                  User?                          @relation("ReviewedDocuments", fields: [reviewed_by_user_id], references: [user_id])
  reviewed_at               DateTime?
  reviewer_remarks          String?                        @db.Text
  status_history            DocumentStatusHistory[]
  assignments               DocumentAssignment[]
  access_requests           DocumentAccessRequest[]
  disposal_requests         DocumentDisposalRequest[]
  workflow_steps            DocumentWorkflowStep[]
  workflow_version_id       BigInt?
  workflow_version          WorkflowVersion?               @relation(fields: [workflow_version_id], references: [workflow_version_id], onDelete: SetNull)
  workflow_snapshot         Json?
  workflow_current_node_key String?                        @db.VarChar(100)
  approver_configuration    DocumentApproverConfiguration?
  transfer_requests         HardcopyTransferRequest[]

  hardcopy HardcopyDocument?
  softcopy SoftcopyDocument?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, created_at])
  @@map("documents")
}

model DocumentDisposalRequest {
  disposal_request_id   BigInt                @id @default(autoincrement())
  document_id           BigInt
  document              Document              @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  requested_by_user_id  BigInt
  requester             User                  @relation("DisposalRequesters", fields: [requested_by_user_id], references: [user_id], onDelete: Restrict)
  disposal_remarks      String                @db.Text
  disposal_action       DisposalAction        @default(Other)
  disposal_action_other String?               @db.VarChar(150)
  status                DisposalRequestStatus @default(Pending)
  reviewed_by_user_id   BigInt?
  reviewer              User?                 @relation("DisposalRequestReviewers", fields: [reviewed_by_user_id], references: [user_id], onDelete: SetNull)
  reviewer_remarks      String?               @db.Text
  reviewed_at           DateTime?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  @@index([status, created_at])
  @@index([document_id, status])
  @@map("document_disposal_requests")
}

model DocumentAssignment {
  document_assignment_id BigInt   @id @default(autoincrement())
  document_id            BigInt
  document               Document @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  user_id                BigInt
  user                   User     @relation("AssignedDocuments", fields: [user_id], references: [user_id], onDelete: Cascade)
  assigned_by            BigInt
  assigner               User     @relation("DocumentAssignmentActors", fields: [assigned_by], references: [user_id], onDelete: Restrict)
  assigned_at            DateTime @default(now())

  @@unique([document_id, user_id])
  @@index([user_id, document_id])
  @@map("document_assignments")
}

model DocumentAccessRequest {
  access_request_id    BigInt                         @id @default(autoincrement())
  document_id          BigInt
  document             Document                       @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  requested_by_user_id BigInt
  requester            User                           @relation("DocumentAccessRequesters", fields: [requested_by_user_id], references: [user_id], onDelete: Cascade)
  request_reason       String?                        @db.Text
  status               DocumentAccessRequestStatus    @default(PENDING)
  reviewed_by_user_id  BigInt?
  reviewer             User?                          @relation("DocumentAccessReviewers", fields: [reviewed_by_user_id], references: [user_id], onDelete: SetNull)
  approver_user_id     BigInt?
  approver             User?                          @relation("DocumentAccessRequestApprovers", fields: [approver_user_id], references: [user_id], onDelete: SetNull)
  reviewer_remarks     String?                        @db.Text
  reviewed_at          DateTime?
  created_at           DateTime                       @default(now())
  updated_at           DateTime                       @updatedAt
  approval_stage       String?                        @db.VarChar(60)
  granted_at           DateTime?
  revoked_at           DateTime?
  expires_at           DateTime?
  history              DocumentAccessRequestHistory[]

  @@index([requested_by_user_id, status, created_at])
  @@index([status, created_at])
  @@index([document_id, requested_by_user_id, status])
  @@map("document_access_requests")
}

model DocumentAccessRequestHistory {
  access_history_id    BigInt                       @id @default(autoincrement())
  access_request_id    BigInt
  access_request       DocumentAccessRequest        @relation(fields: [access_request_id], references: [access_request_id], onDelete: Cascade)
  action               String                       @db.VarChar(40)
  previous_status      DocumentAccessRequestStatus?
  new_status           DocumentAccessRequestStatus
  performed_by_user_id BigInt
  actor                User                         @relation("AccessRequestHistoryActors", fields: [performed_by_user_id], references: [user_id], onDelete: Restrict)
  comments             String?                      @db.Text
  created_at           DateTime                     @default(now())

  @@index([access_request_id, created_at])
  @@map("document_access_request_history")
}

model DocumentStatusHistory {
  history_id      BigInt          @id @default(autoincrement())
  document_id     BigInt
  document        Document        @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  previous_status DocumentStatus?
  new_status      DocumentStatus
  action          String          @db.VarChar(50)
  performed_by    BigInt
  actor           User            @relation("DocumentStatusActors", fields: [performed_by], references: [user_id])
  remarks         String?         @db.Text
  created_at      DateTime        @default(now())

  @@index([document_id, created_at])
  @@map("document_status_history")
}

model HardcopyDocument {
  hardcopy_id BigInt @id @default(autoincrement())

  document_id BigInt   @unique
  document    Document @relation(fields: [document_id], references: [document_id], onDelete: Cascade)

  asset_id BigInt?
  asset    AssetNumber? @relation("AssetHardcopy", fields: [asset_id], references: [asset_id], onDelete: SetNull)

  area_id BigInt
  area    Area   @relation(fields: [area_id], references: [area_id])

  specific_id BigInt?
  specific    Specific? @relation(fields: [specific_id], references: [specific_id])

  location_id BigInt
  location    Location @relation(fields: [location_id], references: [location_id])

  sequence_id BigInt?
  sequence    Sequence? @relation(fields: [sequence_id], references: [sequence_id])

  retention_enabled    Boolean   @default(false)
  retention_start_date DateTime?
  retention_end_date   DateTime?

  attachments       HardcopyAttachment[]
  transfer_requests HardcopyTransferRequest[]

  created_at DateTime @default(now())

  @@map("hardcopy_documents")
}

model HardcopyAttachment {
  attachment_id BigInt           @id @default(autoincrement())
  hardcopy_id   BigInt
  hardcopy      HardcopyDocument @relation(fields: [hardcopy_id], references: [hardcopy_id], onDelete: Cascade)
  file_name     String           @db.VarChar(255)
  file_path     String           @db.VarChar(500)
  file_size     BigInt?
  mime_type     String?          @db.VarChar(100)
  uploaded_by   BigInt
  uploader      User             @relation("UploadedHardcopyAttachments", fields: [uploaded_by], references: [user_id])
  created_at    DateTime         @default(now())

  @@index([hardcopy_id, created_at])
  @@map("hardcopy_attachments")
}

model HardcopyTransferRequest {
  transfer_request_id        BigInt                         @id @default(autoincrement())
  document_id                BigInt
  document                   Document                       @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  hardcopy_id                BigInt
  hardcopy                   HardcopyDocument               @relation(fields: [hardcopy_id], references: [hardcopy_id], onDelete: Cascade)
  from_area_id               BigInt?
  from_area                  Area?                          @relation("HardcopyTransferFromArea", fields: [from_area_id], references: [area_id], onDelete: SetNull)
  from_specific_id           BigInt?
  from_specific              Specific?                      @relation("HardcopyTransferFromSpecific", fields: [from_specific_id], references: [specific_id], onDelete: SetNull)
  from_asset_id              BigInt?
  from_asset                 AssetNumber?                   @relation("HardcopyTransferFromAsset", fields: [from_asset_id], references: [asset_id], onDelete: SetNull)
  from_location_id           BigInt?
  from_location              Location?                      @relation("HardcopyTransferFromLocation", fields: [from_location_id], references: [location_id], onDelete: SetNull)
  from_sequence_id           BigInt?
  from_sequence              Sequence?                      @relation("HardcopyTransferFromSequence", fields: [from_sequence_id], references: [sequence_id], onDelete: SetNull)
  destination_area_id        BigInt?
  destination_area           Area?                          @relation("HardcopyTransferDestinationArea", fields: [destination_area_id], references: [area_id], onDelete: SetNull)
  destination_specific_id    BigInt?
  destination_specific       Specific?                      @relation("HardcopyTransferDestinationSpecific", fields: [destination_specific_id], references: [specific_id], onDelete: SetNull)
  destination_asset_id       BigInt?
  destination_asset          AssetNumber?                   @relation("HardcopyTransferDestinationAsset", fields: [destination_asset_id], references: [asset_id], onDelete: SetNull)
  destination_location_id    BigInt?
  destination_location       Location?                      @relation("HardcopyTransferDestinationLocation", fields: [destination_location_id], references: [location_id], onDelete: SetNull)
  destination_sequence_id    BigInt?
  destination_sequence       Sequence?                      @relation("HardcopyTransferDestinationSequence", fields: [destination_sequence_id], references: [sequence_id], onDelete: SetNull)
  document_copy_number       String?                        @db.VarChar(100)
  current_holder             String?                        @db.VarChar(220)
  transfer_to                String?                        @db.VarChar(220)
  requested_by_user_id       BigInt
  requester                  User                           @relation("TransferRequesters", fields: [requested_by_user_id], references: [user_id], onDelete: Restrict)
  reason                     String                         @db.Text
  approver_user_id           BigInt?
  approver                   User?                          @relation("TransferApprovers", fields: [approver_user_id], references: [user_id], onDelete: SetNull)
  approval_date              DateTime?
  workflow_version_id        BigInt?
  workflow_version_ref       WorkflowVersion?               @relation("HardcopyTransferWorkflowVersions", fields: [workflow_version_id], references: [workflow_version_id], onDelete: SetNull)
  workflow_version           Int?
  workflow_name              String?                        @db.VarChar(150)
  workflow_snapshot          Json?
  current_workflow_step_id   BigInt?                        @unique
  current_workflow_step      HardcopyTransferWorkflowStep?  @relation("HardcopyTransferCurrentStep", fields: [current_workflow_step_id], references: [workflow_step_id], onDelete: SetNull)
  transfer_date              DateTime?
  assigned_recipient_user_id BigInt
  assigned_recipient         User                           @relation("TransferRecipients", fields: [assigned_recipient_user_id], references: [user_id], onDelete: Restrict)
  recipient_acceptance       RecipientAcceptanceStatus      @default(PENDING)
  accepted_by_user_id        BigInt?
  accepted_by                User?                          @relation("TransferAcceptors", fields: [accepted_by_user_id], references: [user_id], onDelete: SetNull)
  acceptance_at              DateTime?
  comments                   String?                        @db.Text
  status                     HardcopyTransferStatus         @default(Draft)
  created_at                 DateTime                       @default(now())
  updated_at                 DateTime                       @updatedAt
  history                    HardcopyTransferHistory[]
  workflow_steps             HardcopyTransferWorkflowStep[] @relation("HardcopyTransferWorkflowSteps")

  @@index([document_id, status])
  @@index([assigned_recipient_user_id, recipient_acceptance])
  @@map("hardcopy_transfer_requests")
}

model HardcopyTransferWorkflowStep {
  workflow_step_id                 BigInt                                @id @default(autoincrement())
  transfer_request_id              BigInt
  transfer_request                 HardcopyTransferRequest               @relation("HardcopyTransferWorkflowSteps", fields: [transfer_request_id], references: [transfer_request_id], onDelete: Cascade)
  current_for_transfer             HardcopyTransferRequest?              @relation("HardcopyTransferCurrentStep")
  node_key                         String                                @db.VarChar(100)
  sequence                         Int
  stage                            String                                @db.VarChar(60)
  stage_label                      String                                @db.VarChar(150)
  assignment_type                  String?                               @db.VarChar(30)
  assignment_source                String?                               @db.VarChar(50)
  assigned_user_id                 BigInt
  assignee                         User                                  @relation("TransferWorkflowStepAssignees", fields: [assigned_user_id], references: [user_id], onDelete: Restrict)
  assigned_role_id                 BigInt?
  assigned_role                    Role?                                 @relation("TransferWorkflowStepAssignedRoles", fields: [assigned_role_id], references: [role_id], onDelete: SetNull)
  assigned_user_name_snapshot      String                                @db.VarChar(255)
  assigned_position_title_snapshot String?                               @db.VarChar(150)
  status                           HardcopyTransferWorkflowStepStatus    @default(QUEUED)
  decision                         String?                               @db.VarChar(30)
  comments                         String?                               @db.Text
  acted_by_user_id                 BigInt?
  actor                            User?                                 @relation("TransferWorkflowStepActors", fields: [acted_by_user_id], references: [user_id], onDelete: SetNull)
  acted_at                         DateTime?
  history                          HardcopyTransferWorkflowStepHistory[]
  created_at                       DateTime                              @default(now())

  @@unique([transfer_request_id, node_key])
  @@index([assigned_user_id, status])
  @@index([transfer_request_id, status])
  @@map("hardcopy_transfer_workflow_steps")
}

model HardcopyTransferWorkflowStepHistory {
  workflow_history_id  BigInt                              @id @default(autoincrement())
  workflow_step_id     BigInt
  workflow_step        HardcopyTransferWorkflowStep        @relation(fields: [workflow_step_id], references: [workflow_step_id], onDelete: Cascade)
  previous_status      HardcopyTransferWorkflowStepStatus?
  new_status           HardcopyTransferWorkflowStepStatus
  action               String                              @db.VarChar(40)
  performed_by_user_id BigInt
  performed_by         User                                @relation("TransferWorkflowHistoryActors", fields: [performed_by_user_id], references: [user_id], onDelete: Restrict)
  comments             String?                             @db.Text
  created_at           DateTime                            @default(now())

  @@index([workflow_step_id, created_at])
  @@map("hardcopy_transfer_workflow_history")
}

model HardcopyTransferHistory {
  transfer_history_id  BigInt                  @id @default(autoincrement())
  transfer_request_id  BigInt
  transfer_request     HardcopyTransferRequest @relation(fields: [transfer_request_id], references: [transfer_request_id], onDelete: Cascade)
  action               String                  @db.VarChar(40)
  previous_status      HardcopyTransferStatus?
  new_status           HardcopyTransferStatus
  performed_by_user_id BigInt
  performed_by         User                    @relation("TransferHistoryActors", fields: [performed_by_user_id], references: [user_id], onDelete: Restrict)
  comments             String?                 @db.Text
  created_at           DateTime                @default(now())

  @@index([transfer_request_id, created_at])
  @@map("hardcopy_transfer_history")
}

model SoftcopyCategory {
  softcopy_category_id BigInt             @id @default(autoincrement())
  category_name        String             @db.VarChar(150)
  folder_name          String             @unique @db.VarChar(160)
  description          String?            @db.Text
  is_active            Boolean            @default(true)
  parent_category_id   BigInt?
  created_by_user_id   BigInt?
  creator              User?              @relation("CreatedSoftcopyCategories", fields: [created_by_user_id], references: [user_id], onDelete: SetNull)
  parent               SoftcopyCategory?  @relation("SoftcopyCategoryHierarchy", fields: [parent_category_id], references: [softcopy_category_id], onDelete: Restrict)
  subcategories        SoftcopyCategory[] @relation("SoftcopyCategoryHierarchy")
  softcopies           SoftcopyDocument[]
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  @@unique([parent_category_id, category_name])
  @@index([parent_category_id])
  @@index([created_by_user_id])
  @@map("softcopy_categories")
}

model SoftcopyDocument {
  softcopy_id BigInt @id @default(autoincrement())

  document_number String? @db.VarChar(100)
  series_number   String? @db.VarChar(50)

  document_id BigInt   @unique
  document    Document @relation(fields: [document_id], references: [document_id], onDelete: Cascade)

  softcopy_category_id BigInt
  category             SoftcopyCategory @relation(fields: [softcopy_category_id], references: [softcopy_category_id], onDelete: Restrict)

  current_revision_id BigInt?
  current_revision    DocumentRevision? @relation("CurrentRevision", fields: [current_revision_id], references: [revision_id])

  revisions   DocumentRevision[]   @relation("DocumentRevisions")
  attachments SoftcopyAttachment[]

  created_at DateTime @default(now())

  @@map("softcopy_documents")
}

model SoftcopyAttachment {
  attachment_id       BigInt                   @id @default(autoincrement())
  softcopy_id         BigInt
  softcopy            SoftcopyDocument         @relation(fields: [softcopy_id], references: [softcopy_id], onDelete: Cascade)
  file_name           String                   @db.VarChar(255)
  file_path           String                   @db.VarChar(500)
  file_size           BigInt?
  mime_type           String?                  @db.VarChar(100)
  uploaded_by         BigInt
  uploader            User                     @relation("UploadedSoftcopyAttachments", fields: [uploaded_by], references: [user_id])
  status              SoftcopyAttachmentStatus @default(PendingApproval)
  approved_by_user_id BigInt?
  approved_by         User?                    @relation("ApprovedSoftcopyAttachments", fields: [approved_by_user_id], references: [user_id], onDelete: SetNull)
  approved_at         DateTime?
  rejected_by_user_id BigInt?
  rejected_by         User?                    @relation("RejectedSoftcopyAttachments", fields: [rejected_by_user_id], references: [user_id], onDelete: SetNull)
  rejected_at         DateTime?
  rejection_reason    String?                  @db.Text
  created_at          DateTime                 @default(now())

  @@index([softcopy_id, created_at])
  @@map("softcopy_attachments")
}

model DocumentRevision {
  revision_id BigInt @id @default(autoincrement())

  softcopy_id BigInt
  softcopy    SoftcopyDocument @relation("DocumentRevisions", fields: [softcopy_id], references: [softcopy_id], onDelete: Cascade)

  revision_number         String    @db.VarChar(50)
  reason_of_revision      String?   @db.Text
  effective_date          DateTime?
  page_number             String?   @db.VarChar(50)
  series_number           String?   @db.VarChar(50)
  document_title          String    @default("") @db.VarChar(255)
  revision_level_from     String?   @db.VarChar(50)
  revision_level_to       String?   @db.VarChar(50)
  previous_effective_date DateTime?
  new_effective_date      DateTime?
  date_received           DateTime?
  date_released           DateTime?
  approval_date           DateTime?
  is_current              Boolean   @default(false)
  is_historical           Boolean   @default(false)
  approved_by_user_id     BigInt?
  approver                User?     @relation("ApprovedRevisions", fields: [approved_by_user_id], references: [user_id], onDelete: SetNull)
  approved_at             DateTime?

  file_name String  @db.VarChar(255)
  file_path String  @db.VarChar(500)
  file_size BigInt?
  mime_type String? @db.VarChar(100)

  superseded_by_revision_id BigInt?
  superseded_by_revision    DocumentRevision?  @relation("RevisionCorrections", fields: [superseded_by_revision_id], references: [revision_id], onDelete: SetNull)
  correction_revisions      DocumentRevision[] @relation("RevisionCorrections")
  correction_reason         String?            @db.Text

  uploaded_by BigInt
  uploader    User   @relation("UploadedRevisions", fields: [uploaded_by], references: [user_id])

  current_for_documents SoftcopyDocument[]         @relation("CurrentRevision")
  artifacts             SoftcopyRevisionArtifact[]

  created_at DateTime @default(now())

  @@unique([softcopy_id, revision_number])
  @@map("document_revisions")
}

model SoftcopyRevisionArtifact {
  artifact_id        BigInt               @id @default(autoincrement())
  revision_id        BigInt
  revision           DocumentRevision     @relation(fields: [revision_id], references: [revision_id], onDelete: Cascade)
  artifact_type      SoftcopyArtifactType
  file_name          String               @db.VarChar(255)
  file_path          String               @db.VarChar(500)
  file_size          BigInt
  mime_type          String               @db.VarChar(100)
  source_fingerprint String               @db.VarChar(128)
  generator_version  String               @db.VarChar(50)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt

  @@unique([revision_id, artifact_type])
  @@index([source_fingerprint])
  @@map("softcopy_revision_artifacts")
}

